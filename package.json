{
  "name": "bookie-bookie",
  "version": "0.1.0",
  "private": true,
  "engines": {"node": ">=22"},
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "worker": "node --env-file-if-exists=.env.local --import tsx worker/booking-worker.ts",
    "reconcile": "node --env-file-if-exists=.env.local --import tsx worker/reconcile.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.0.0",
    "@supabase/supabase-js": "^2.0.0",
    "next": "16.4.6",
    "postgres": "^3.4.0",
    "qrcode": "^1.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  }
}
