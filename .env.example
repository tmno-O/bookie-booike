DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres
# Supabase transaction pooler (port 6543): DATABASE_PREPARE=false and a small DATABASE_POOL_MAX
DATABASE_POOL_MAX=10
DATABASE_PREPARE=true
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_PUBLISHABLE_KEY=
# db (default): Postgres queue decided by the API right after it responds; no worker or SQS needed.
# sqs (optional): SQS FIFO + `npm run worker`; needs ElasticMQ locally (docker compose) and the SQS_* settings below.
QUEUE_DRIVER=db
SQS_REGION=us-east-1
SQS_ENDPOINT=http://127.0.0.1:9324
SQS_QUEUE_URL=http://127.0.0.1:9324/000000000000/booking-requests.fifo
NEXT_PUBLIC_API_MODE=mock
LINE_VERIFY_MODE=mock
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
LINE_SECRET_KEY=
LINE_NOTIFICATIONS_ENABLED=false
# Random secret (at least 32 characters) for POST /api/internal/notifications/drain
CRON_SECRET=
BOOKING_RATE_LIMIT_PER_MINUTE=30
BOOKING_MAX_RECEIVES=5
